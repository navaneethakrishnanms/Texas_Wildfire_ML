# ============================================================
#  Wildfire Ignition Prediction System — .gitignore
#
#  PUSHED TO GITHUB  ✅
#    - All Python source code (.py)
#    - All config files (.yaml, .json)
#    - Markdown reports and README files (.md)
#    - Small summary CSVs (tuning_results, gate1, gate2 etc.)
#    - requirements.txt / environment files
#
#  NOT PUSHED  ❌
#    - Raw data files (xlsx, nc, tif, parquet, csv datasets)
#    - HRRR downloaded GRIB2 + extracted parquets
#    - Model weight files (.ubj, .pkl, .bin)
#    - Logs, Python cache, temp files
#
#  NOTE: patterns below use no leading "/" and (where useful) "**/"
#  so they match at any depth (e.g. under TX/, V1/, V2/), not just repo root.
# ============================================================

# ── OS ARTIFACTS ─────────────────────────────────────────────
nul
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── RAW / LARGE DATASET FILES (any depth) ────────────────────
*.xlsx
*.xls
final_training_dataset_tx*.xlsx
final_training_dataset_tx*.csv

# ── DATA FOLDERS (any depth: TX/data/, V1/data/, V2/data/, ...) ─
**/data/**/*.parquet
**/data/**/*.feather
**/data/**/*.csv
**/data/*.parquet
**/data/*.feather
**/data/*.csv

# ── HRRR DOWNLOADED DATA (GBs of GRIB2 + extracted parquets) ─
**/data/hrrr/
# Also Herbie's default cache outside the project
# (C:/Users/nk/data/hrrr/ — not in project but noted)

# ── MODEL WEIGHTS (outputs/ folders, any depth) ───────────────
**/outputs/**/*.ubj
**/outputs/**/*.pkl
**/outputs/**/*.bin
**/outputs/**/*.model
**/outputs/**/*.joblib

# ── KEEP small metric/tuning CSVs and metadata in outputs ─────
!**/outputs/**/tuning_results.csv
!**/outputs/**/*_meta.json

# ── RAW FPA-FOD SOURCE DATA ───────────────────────────────────
V2/data/*_FPA_FOD_cons.csv

# ── GRIDMET NETCDF FILES ──────────────────────────────────────
V2/data/gridmet/
**/*.nc
**/*.nc4
**/*.hdf
**/*.hdf5
**/*.h5

# ── RASTER / GIS FILES ───────────────────────────────────────
# Note: PLACE_RASTERS_HERE.txt inside V2/data/rasters/ is kept (tracked as a guide)
**/*.tif
**/*.tiff
**/*.geotiff
**/*.img
**/*.vrt
**/*.shp
**/*.dbf
**/*.shx
**/*.prj
**/*.cpg
**/*.sbn
**/*.sbx
**/*.zip
**/*.gpkg

# ── LARGE PROCESSED DATASETS (V2 pipeline) ───────────────────
V2/data/processed/**/*.parquet
V2/data/raw/**/*.parquet
V2/data/**/*.parquet
V2/phase2/outputs/**/*.parquet
V2/phase2/outputs/**/*.feather
V2/phase2/outputs/**/final_training_dataset_*.csv
V2/phase2/outputs/**/train_*.csv
V2/phase2/outputs/**/val_*.csv
V2/phase2/outputs/**/test_*.csv
V2/phase2/outputs/**/sample_1000_*.csv
V2/phase2/outputs/**/gridmet_features_*.csv
V2/phase2/outputs/**/static_features_*.csv
V2/phase2/outputs/**/csv_exports/

# Phase 3 risk-map outputs (maps/ folder — large prediction CSVs + HTML)
V2/phase2/outputs/**/maps/*.csv
V2/phase2/outputs/**/maps/*.html

# ── KEEP small schema/report CSVs (human-readable, < 1MB) ────
!V2/phase2/outputs/**/gate1_removed.csv
!V2/phase2/outputs/**/gate2_removed.csv
!V2/phase2/outputs/**/feature_schema.csv
!V2/phase2/outputs/**/cleaned_feature_schema.csv
!V2/phase2/outputs/**/feature_source_map.csv
!V2/phase2/outputs/**/missing_root_cause.csv
!V2/phase2/outputs/**/production_availability.csv
!V2/phase2/outputs/**/static_dynamic_features.csv
!V2/phase2/outputs/**/h3_ecoregion_breakdown_*.csv
!V2/phase2/outputs/**/h3_grid_summary_*.csv
!V2/phase2/outputs/**/phase2c_summary.csv
!V2/phase2/outputs/**/phase2d_summary.csv

# ⬛ TEXAS PIPELINE (TX/) — code only, no result CSVs/data ⬛
TX/outputs/**/*.csv
TX/outputs/**/*.log

# ⬛ TEXAS/ folder — exclude data files and model weights, keep code & reports ⬛
TEXAS/**/*.parquet
TEXAS/**/*.feather
TEXAS/**/*.csv
TEXAS/**/*.pkl
TEXAS/**/*.ubj
TEXAS/**/*.bin
TEXAS/**/*.joblib
TEXAS/**/*.cbm
# TEXAS JSON model files (large trained model outputs, not config)
TEXAS/model_*.json
TEXAS/training_results_*.json

# ⬛ TEXAS_v1_backup/ — exclude all data & model files ⬛
TEXAS_v1_backup/**/*.parquet
TEXAS_v1_backup/**/*.feather
TEXAS_v1_backup/**/*.csv
TEXAS_v1_backup/**/*.pkl
TEXAS_v1_backup/**/*.ubj
TEXAS_v1_backup/**/*.bin
TEXAS_v1_backup/**/*.joblib
TEXAS_v1_backup/**/*.cbm
TEXAS_v1_backup/model_*.json
TEXAS_v1_backup/training_results_*.json

# ── SUPPORTING_FILES / FOCUSED_FILES — data & model outputs ───
# Parquet and CSV data files at any depth (they are large)
Supporting_files/**/*.parquet
Supporting_files/**/*.csv
Focused_Files/**/*.parquet
Focused_Files/**/*.csv

# KEEP small JSON metadata/results in Supporting_files (scripts produce these)
!Supporting_files/**/*_meta.json
!Supporting_files/**/tuning_results.csv

# Model binary weights inside Supporting_files
Supporting_files/**/*.pkl
Supporting_files/**/*.ubj
Supporting_files/**/*.bin
Supporting_files/**/*.model
Supporting_files/**/*.joblib
Supporting_files/**/*.cbm

# ── MODEL WEIGHTS / SAVED MODELS (all formats, any depth) ────
**/*.pkl
**/*.pickle
**/*.joblib
**/*.model
**/*.bin
**/*.cbm
**/*.ubj
V2/phase2/outputs/**/models/

# ── LOGS ─────────────────────────────────────────────────────
**/*.log
V2/logs/
V2/phase2/logs/
V1/logs/

# ── PYTHON CACHE ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
*.pyc

# ── JUPYTER ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── VIRTUAL ENVIRONMENTS ──────────────────────────────────────
.env
.venv/
venv/
env/
conda-env/
*.egg-info/
dist/
build/

# ── IDE / EDITOR ─────────────────────────────────────────────
.idea/
.vscode/
*.code-workspace
*.swp
*.swo

# ── TEMP / SCRATCH ────────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp
*.bak

# ── TDIS_REPLICA — data, secrets, frontend deps, cache ────────
# Large parquet data feeds (live + historical, hundreds of MB each)
TDIS_REPLICA/data/
# Python cache inside the replica services
TDIS_REPLICA/**/__pycache__/
TDIS_REPLICA/**/*.pyc
# Frontend secrets / local env overrides
TDIS_REPLICA/frontend/.env
TDIS_REPLICA/frontend/.env.*
# EXCEPTION: .env.production holds only the public backend URL (not a
# secret -- it ends up visible in the compiled JS bundle anyway), and is
# committed deliberately so Azure Static Web Apps' GitHub Actions build
# picks it up automatically at build time.
!TDIS_REPLICA/frontend/.env.production
# Backend local config -- never commit (holds API_KEY; in Azure this is set
# via Container App "Environment variables" instead, not a checked-in file).
TDIS_REPLICA/api/.env
# Node dependencies (never commit node_modules)
# ── texas-backend/ — standalone backend deployment folder ─────
# Same reasoning as TDIS_REPLICA/api and TDIS_REPLICA/data above: parquet
# files are large and gitignored, .env holds local config.
texas-backend/data/
texas-backend/api/.env
texas-backend/**/__pycache__/
texas-backend/**/*.pyc
TDIS_REPLICA/frontend/node_modules/
TDIS_REPLICA/frontend/dist/
TDIS_REPLICA/frontend/.vite/
# Service logs
TDIS_REPLICA/**/*.log

# ── TDIS-PORTAL-HANDOFF — archives and logs ───────────────────
# Large binary tarballs (download separately, don't bloat history)
tdis-portal-handoff-main/**/*.tar.gz
tdis-portal-handoff-main/**/*.tar
tdis-portal-handoff-main/**/*.zip
tdis-portal-handoff-main/**/*.log

# ── NODE / FRONTEND (root-level, if any) ─────────────────────
node_modules/
package-lock.json
dist/
.vite/

# ── TDIS_Ignition/ — code & docs kept, data/model weights ignored ─
# Large parquet data files at every depth
TDIS_Ignition/**/*.parquet
TDIS_Ignition/**/*.feather
TDIS_Ignition/**/*.csv
# Model weights (large XGBoost/joblib files)
TDIS_Ignition/**/*.joblib
TDIS_Ignition/**/*.pkl
TDIS_Ignition/**/*.ubj
TDIS_Ignition/**/*.bin
TDIS_Ignition/**/*.cbm
# Large trained-model JSON dumps (30 MB+), keep small config/result JSONs
TDIS_Ignition/model/tdis_forecast_hrrr_filtered.json
TDIS_Ignition/model/tdis_forecast_hrrr_tuned_d9.json
# Logs
TDIS_Ignition/**/*.log
# KEEP: code scripts, docs, markdown, small JSON reports, PNGs, requirements
!TDIS_Ignition/**/*.py
!TDIS_Ignition/**/*.sh
!TDIS_Ignition/**/*.md
!TDIS_Ignition/**/*.txt
!TDIS_Ignition/**/*.png
!TDIS_Ignition/**/*.json
# Re-exclude the known large model JSONs (overrides the !*.json above)
TDIS_Ignition/model/tdis_forecast_hrrr_filtered.json
TDIS_Ignition/model/tdis_forecast_hrrr_tuned_d9.json

# ── TDIS_Ignition_BIT/ — code & docs kept, data/model weights ignored ─
TDIS_Ignition_BIT/**/*.parquet
TDIS_Ignition_BIT/**/*.feather
TDIS_Ignition_BIT/**/*.csv
TDIS_Ignition_BIT/**/*.joblib
TDIS_Ignition_BIT/**/*.pkl
TDIS_Ignition_BIT/**/*.ubj
TDIS_Ignition_BIT/**/*.bin
TDIS_Ignition_BIT/**/*.cbm
# Large model JSON (21 MB)
TDIS_Ignition_BIT/model/model_bit_38feat.json
TDIS_Ignition_BIT/**/*.log
!TDIS_Ignition_BIT/**/*.py
!TDIS_Ignition_BIT/**/*.sh
!TDIS_Ignition_BIT/**/*.md
!TDIS_Ignition_BIT/**/*.txt
!TDIS_Ignition_BIT/**/*.json
TDIS_Ignition_BIT/model/model_bit_38feat.json

# ── Large archive files ───────────────────────────────────────
# The BIT zip is 160 MB — don't commit it
TDIS_Ignition_BIT.zip
